{
  "$schema": "node_modules/luvabase/manifest-schema.json",
  "identifier": "skrivla",
  "name": "Skrivla",
  "subtitle": "Collaborative text editor",
  "icon": "public/apple-icon.png",
  "repository": "https://github.com/simonbengtsson/skrivla",
  "description": "Skrivla is your self-hostable collaborative document editor. Think Google Docs, but specifically designed for quick brainstorming sessions, meeting notes, and more. Share a page link, and anyone can collaborate on it.",
  "surfaces": [
    {
      "type": "web"
    }
  ],
  "accessLevel": "public",
  "screenshots": [
    "public/screenshot.png"
  ],
  "proxyResponses": {
    "/.well-known/openai-apps-challenge": "cyu8tmVdoZAxSobegQMa27XgIdDni_brt7NFzrFNIcs",
  }
}
