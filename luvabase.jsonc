{
  "$schema": "node_modules/luvabase/manifest-schema.json",
  "identifier": "skrivla",
  "name": "Skrivla",
  "subtitle": "Write together with anyone and bring your own AI",
  "icon": "public/apple-icon.png",
  "repository": "https://github.com/simonbengtsson/skrivla",
  "description": "Skrivla is where people and AI write together. It's like a minimal Google Docs or Notion where you can easily bring your own AI. Perfect for quick brainstorming sessions, feature specs, meeting notes, and more.",
  "surfaces": [
    {
      "type": "web"
    }
  ],
  "accessLevel": "public",
  "screenshots": [
    "public/screenshot.png"
  ],
  "proxyResponses": {
    "/.well-known/openai-apps-challenge": "cyu8tmVdoZAxSobegQMa27XgIdDni_brt7NFzrFNIcs",
  }
}